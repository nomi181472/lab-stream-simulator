# StreamLab Virtual IP Camera Simulator - Environment Configuration

# Application Environment
STREAMLAB_ENV=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# MediaMTX & Streaming Ports
RTSP_HOST=127.0.0.1
RTSP_PORT=8554
RTMP_PORT=1935
HLS_PORT=8888
WEBRTC_PORT=8889
MEDIAMTX_API_PORT=8555

# ONVIF & WS-Discovery
WS_DISCOVERY_INTERFACE=0.0.0.0
WS_DISCOVERY_PORT=3702
WS_DISCOVERY_MULTICAST_GROUP=239.255.255.250

# Database Configuration (SQLite default with PostgreSQL support)
DB_URL=sqlite+aiosqlite:///./data/streamlab.db
# POSTGRES_URL=postgresql+asyncpg://streamlab:streamlab_pass@localhost:5432/streamlab

# Storage Paths
STORAGE_ROOT=./storage
FIXTURES_DIR=./storage/fixtures
SNAPSHOTS_DIR=./storage/snapshots

# Binary Overrides (Defaults use ./bin/ or system PATH)
# FFMPEG_PATH=./bin/ffmpeg.exe
# FFPROBE_PATH=./bin/ffprobe.exe
# MEDIAMTX_PATH=./bin/mediamtx.exe

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/cameras
